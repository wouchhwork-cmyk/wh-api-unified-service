# ---------------------------------------------------------------------------
# The complete list of variables this service reads. See backend-design.md §4.
#
#   .env.dev / .env.qa  committed, NO real secrets
#   .env.local          gitignored, your own secrets, overrides .env.dev
#   prod                injected by the deployment platform, nothing in the repo
# ---------------------------------------------------------------------------

NODE_ENV=dev                      # dev | qa | prod
PORT=3000
APP_VERSION=dev
API_PREFIX=api

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wouchh_dev
DB_USER=wouchh
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=15000

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET=                # >= 32 chars. Secret manager in prod.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# --- Crypto (secret manager in prod — never a real value in this repo) ----
TOKEN_ENCRYPTION_KEY_ID=k1        # which key version encrypts new rows
TOKEN_ENCRYPTION_KEY_K1=          # base64 of exactly 32 bytes for AES-256-GCM. Add K2, K3… when rotating.
VERIFICATION_HMAC_PEPPER=         # >= 32 chars

# --- Workers --------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
WORKER_IDLE_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=120
EXPIRY_WARNING_WINDOW_DAYS=7
EXPIRY_SWEEP_CRON=0 * * * *

# --- Meta integration (backend-design.md §18) -----------------------------
META_ENABLED=false                # when true, every FB_* below is required
FB_APP_ID=
FB_APP_SECRET=
FB_LOGIN_CONFIG_ID=               # Facebook Login for Business config id
GRAPH_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/connections/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
FRONTEND_DASHBOARD_URL=http://localhost:5173/dashboard

# --- Observability --------------------------------------------------------
LOG_LEVEL=info                    # fatal|error|warn|info|debug|trace
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# --- Verification delivery / OTP ---------------------------------------------
OTP_REALTIME_ENABLED=false
OTP_STATIC_CODE=666666

# --- Platform admin ----------------------------------------------------------
# Off by default. When enabled, all three fields are required, and prod also
# requires a password of at least 16 characters.
PLATFORM_ADMIN_ENABLED=false
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_MOBILE=
PLATFORM_ADMIN_PASSWORD=
