# ===========================================================================
# dev — COMMITTED. Contains no real secrets.
#
# The crypto values here are deliberately fake placeholders so a developer can
# boot with zero setup. They are not secrets and must never reach qa or prod.
# Real Meta credentials belong in .env.local (gitignored) along with
# META_ENABLED=true.
# ===========================================================================
NODE_ENV=dev
PORT=3000
APP_VERSION=dev
API_PREFIX=api

DB_HOST=localhost
DB_PORT=5544
DB_NAME=wouchh
DB_USER=wouchh
DB_PASSWORD=wouchh_dev_local
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=15000

JWT_ACCESS_SECRET=dev-only-placeholder-not-a-real-secret-0001
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

TOKEN_ENCRYPTION_KEY_ID=k1
TOKEN_ENCRYPTION_KEY_K1=ZGV2LW9ubHktZmFrZS1rZXktMzItYnl0ZXMtbG9uZyE=
VERIFICATION_HMAC_PEPPER=dev-only-placeholder-pepper-not-a-secret

WORKER_POLL_INTERVAL_MS=2000
WORKER_IDLE_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=120
EXPIRY_WARNING_WINDOW_DAYS=7
EXPIRY_SWEEP_CRON=0 * * * *

META_ENABLED=false
FB_APP_ID=
FB_APP_SECRET=
FB_LOGIN_CONFIG_ID=
GRAPH_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/connections/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
FRONTEND_DASHBOARD_URL=http://localhost:5173/dashboard

LOG_LEVEL=debug
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Verification delivery / OTP ---------------------------------------------
# OFF: nothing is sent to a real vendor and every numeric code is OTP_STATIC_CODE,
# so signup is walkable without an SMS or email contract. Prod refuses to boot
# with this off.
OTP_REALTIME_ENABLED=false
OTP_STATIC_CODE=666666

# --- Platform admin (internal staff, login only — there is no staff signup) ---
PLATFORM_ADMIN_ENABLED=true
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=admin@wouchh.com
PLATFORM_ADMIN_MOBILE=8408994828
PLATFORM_ADMIN_PASSWORD=1234
