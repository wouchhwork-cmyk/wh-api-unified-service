node_modules/
dist/
coverage/
*.log
.DS_Store

# Env: .env.dev / .env.qa are committed and hold NO real secrets.
# Everything else, including any developer's own overrides, stays out.
.env
.env.local
.env.*.local
.env.prod
!.env.dev
!.env.qa
!.env.example

# Auto-resume runtime state — logs, locks and the pending marker are local
# to one machine and one task; the script and plist beside them are not.
.claude/auto-resume*.log
.claude/.auto-resume.*
.claude/RESUME-PENDING
.claude/.session-heartbeat
