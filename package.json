{
  "name": "wh-api-unified-service",
  "version": "0.1.0",
  "description": "Wouchh unified API \u2014 social inbox, comments and posts for connected enterprises",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:local": "node --env-file=.env.dev --env-file-if-exists=.env.local dist/main.js",
    "dev": "pnpm db:sync && pnpm build && pnpm start:local",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:workers": "node dist/workers/main.js",
    "start:workers:dev": "nest start --watch --entryFile workers/main",
    "start:workers:debug": "nest start --debug --watch --entryFile workers/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:schema": "SCHEMA_PARITY=1 vitest run --project integration schema-parity",
    "test:all": "vitest run",
    "db:migrate": "node --env-file=.env.dev --import tsx scripts/db.ts migrate",
    "db:sync": "node --env-file=.env.dev --import tsx scripts/db.ts sync",
    "db:revert": "node --env-file=.env.dev --import tsx scripts/db.ts revert",
    "db:drop": "node scripts/assert-not-prod.js && node --env-file=.env.dev --import tsx scripts/db.ts drop",
    "db:seed": "node --env-file=.env.dev --import tsx scripts/seed.ts",
    "db:reset": "pnpm db:drop && pnpm db:migrate && pnpm db:seed",
    "db:check": "node --env-file=.env.dev --import tsx scripts/schema-check.ts",
    "openapi:export": "node --env-file=.env.dev --import tsx scripts/export-openapi.ts",
    "db:status": "node --env-file=.env.dev --import tsx scripts/db.ts status"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@node-rs/argon2": "2.1.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.11",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "ulid": "3.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.2",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "testcontainers": "11.7.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
