# ===========================================================================
# qa — COMMITTED. Contains no secrets, by design.
#
# Every blank value below is supplied by the qa deployment environment.
# Booting qa without them fails config validation at startup, which is the
# intended behaviour — see backend-design.md §4.1.
# ===========================================================================
NODE_ENV=qa
PORT=3000
API_PREFIX=api

DB_PORT=5432
DB_NAME=wouchh_qa
DB_SSL=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=15000

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

TOKEN_ENCRYPTION_KEY_ID=k1

WORKER_POLL_INTERVAL_MS=2000
WORKER_IDLE_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=120
EXPIRY_WARNING_WINDOW_DAYS=7
EXPIRY_SWEEP_CRON=0 * * * *

META_ENABLED=true
GRAPH_API_VERSION=v25.0

LOG_LEVEL=info
SWAGGER_ENABLED=true

# Supplied by the deployment environment, never committed:
#   DB_HOST DB_USER DB_PASSWORD
#   JWT_ACCESS_SECRET TOKEN_ENCRYPTION_KEY_K1 VERIFICATION_HMAC_PEPPER
#   FB_APP_ID FB_APP_SECRET FB_LOGIN_CONFIG_ID META_WEBHOOK_VERIFY_TOKEN
#   META_OAUTH_REDIRECT_URI FRONTEND_DASHBOARD_URL CORS_ORIGINS APP_VERSION
